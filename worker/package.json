{
  "name": "aicountly-qa-worker",
  "private": true,
  "version": "0.2.0",
  "description": "Dedicated AICOUNTLY QA Portal Playwright worker (not the shared smoke/global worker)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch index.ts",
    "start": "node dist/index.js",
    "start:tsx": "tsx index.ts",
    "qa:basic-check": "tsx index.ts --mode=basic-check",
    "qa:run-session": "tsx index.ts --mode=run-session",
    "qa:books": "tsx index.ts --mode=books",
    "qa:reports": "tsx index.ts --mode=reports",
    "qa:validate": "tsx index.ts --mode=validate",
    "qa:cleanup": "tsx index.ts --mode=cleanup",
    "playwright:install": "playwright install --with-deps chromium",
    "test": "tsx --test auth/jumpTargets.test.ts utils/hostGuard.test.ts"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
