# AICOUNTLY QA Portal — dedicated Playwright worker (aicountly-qa-worker)
# Copy to .env on the QA cPanel host; never commit a real .env.
#
# Production path (outside public_html):
#   /home/<QA_CPANEL_USER>/aicountly-qa-worker
# PM2 name (must be unique):
#   aicountly-qa-worker
#
# This worker is NOT the shared host at worker.apis.aicountly.com.
# Use QA_* variables only — never SMOKE_* or WORKER_SHARED_TOKEN.

# QA portal API (CodeIgniter on qa.aicountly.org).
QA_API_URL=https://qa.aicountly.org/api

# Shared secret — must match QA_WORKER_TOKEN in public_html/api/.env.
QA_WORKER_TOKEN=

# Host identifier sent on claim / ping / heartbeat (visible in Live Log).
QA_WORKER_ID=aicountly-qa-worker

# Polling / lease liveness.
QA_POLL_INTERVAL_MS=5000
QA_HEARTBEAT_MS=15000

# Local evidence root (absolute, outside public_html preferred).
QA_REPORTS_DIR=/home/YOUR_CPANEL_USER/qa-reports

# File I/O fixtures + manifest.json. Defaults to <repo>/samples/fixtures, falling
# back to the worker-local ./fixtures folder. See docs/QA-FILE-IO.md.
# QA_FIXTURES_DIR=/home/YOUR_CPANEL_USER/aicountly-qa/samples/fixtures

# Headless Chromium (1/true = headless).
QA_HEADLESS=1
QA_SLOWMO_MS=0

# Optional Jump To overrides (product-scoped only — no global Books default).
# QA_JUMP_TO_BOOKS=Smart Books
# QA_JUMP_TO_HRMS=HRMS

# --- AI Brain (vision agent) --------------------------------------------
# See docs/QA-BRAIN.md for the full architecture. All provider calls are
# proxied through the QA API (POST /v1/worker/brain/invoke) — this worker
# never talks to Gemini/OpenAI/Perplexity directly and never holds a key.

# 'template' (default) runs today's deterministic step-by-step execution
# unchanged (stepRunner.ts). 'agent' runs the vision agent loop instead
# (agentLoop.ts): it perceives the screen via Set-of-Marks, decides one
# action at a time, and must satisfy the session's capture contract before
# it may finish. A server-side `brain.agent_mode` setting also exists but is
# not yet threaded into the next-session payload — see resolveAgentMode()
# in worker/runner/sessionRunner.ts for the exact fallback chain.
QA_AGENT_MODE=template

# Safety ceiling on screens the vision agent may visit in one session
# (agent mode only; ignored in template mode). Not a target — session scope
# is discovery-driven, this only stops a runaway loop.
QA_MAX_SCREENS_PER_SESSION=60

# How many of the vision agent's per-step decision screenshots to keep on
# disk (agent mode only). Older step screenshots are pruned from disk but
# stay in the step timeline without an image.
QA_STEP_SCREENSHOT_RETENTION=120

# Off by default. When enabled, each session runs an extra AI council call
# (Perplexity + OpenAI -> Gemini arbiter) that compares the product against
# competitor catalogs and posts findings to `qa_feature_gaps`. Enrichment
# only — it never affects a session's pass/fail status.
QA_FEATURE_GAP_ENABLED=false

# NEVER set GEMINI_API_KEY / OPENAI_API_KEY / PERPLEXITY_API_KEY in this
# file or in this worker's environment. Those keys live ONLY in
# server-php/.env; this worker proxies every AI call through the QA API.
# validateConfig() (worker/utils/config.ts) hard-fails startup if any of
# these three variables is present in the worker's process environment.
