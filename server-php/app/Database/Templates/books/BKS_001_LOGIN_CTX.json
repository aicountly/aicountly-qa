{
  "code": "BKS_001_LOGIN_CTX",
  "name": "Login & Company Context",
  "product": "books",
  "module": "Login",
  "description": "Use the two-step Jump To login for Smart Books and confirm the authenticated app shell loads. On sandbox, also set company / branch / FY context.",
  "severity_on_fail": "critical",
  "steps": [
    { "kind": "navigate", "to": "{login_url}", "expect": "identity form and Jump To visible" },
    { "kind": "fill", "selector_options": ["input[name=email]", "input[name=username]", "input[type=email]", "#email", "#username"], "value": "{username}" },
    { "kind": "select", "selector_options": ["select#jumptoe", "select[name=jumptoe]"], "value_options": ["Smart Books", "{jump_to}", "books"] },
    { "kind": "click", "selector_options": ["button[type=submit]:has-text('SIGN IN')", "button:has-text('SIGN IN')", "input[type=submit]"] },
    { "kind": "expect_visible", "selector_options": ["input[type=password]", "input[name=password]", "#password"], "timeout_ms": 30000, "on_failure_note": "Password step did not appear after selecting Jump To. Surface visible Jump To, credential, OTP, or challenge error text in failed_steps." },
    { "kind": "fill", "selector_options": ["input[type=password]", "input[name=password]", "#password"], "value": "{password}" },
    { "kind": "click", "selector_options": ["button[type=submit]:has-text('CONTINUE')", "button:has-text('CONTINUE')", "button:has-text('SIGN IN')", "input[type=submit]"] },
    { "kind": "expect_login_outcome", "success_url_matches": "/dashboard|/home|/companies|/company|/app|/books|/workspace", "login_url_matches": "/login", "error_selector_options": ["[role=alert]", ".alert-danger", ".error", ".invalid-feedback", "[class*=error]"], "error_text_matches": "jump to|credential|password|invalid|incorrect|otp|verification|challenge", "failed_steps_note": "Login remained on /login. Record visible Jump To, credential, password, OTP, verification, or challenge text." },
    { "kind": "expect_product_host", "expected_base_url": "{base_url}", "allowed_domains": "{allowed_domains}", "recover_once": true, "rule_code": "AUTH_PRODUCT_HOST_MATCH", "on_failure_note": "Login reached the wrong product host. Capture the landed URL and Jump To selection, then fail instead of collecting unrelated product evidence." },
    { "kind": "expect_url",   "matches": "/dashboard|/home|/companies|/company|/app|/books|/workspace" },
    { "kind": "select_or_create_company", "name_template": "{QA_RUN_ID} Test Company Pvt Ltd" },
    { "kind": "select_or_create_branch",  "name_template": "{QA_RUN_ID} HO" },
    { "kind": "select_or_create_financial_year", "name": "FY 2026-27", "start": "2026-04-01", "end": "2027-03-31" },
    { "kind": "expect_visible", "selector": "[data-test=app-shell],main,#app,.app-shell,.dashboard" }
  ],
  "steps_by_env": {
    "prod_basic": [
      { "kind": "navigate", "to": "{login_url}", "expect": "identity form and Jump To visible" },
      { "kind": "fill", "selector_options": ["input[name=email]", "input[name=username]", "input[type=email]", "#email", "#username"], "value": "{username}" },
      { "kind": "select", "selector_options": ["select#jumptoe", "select[name=jumptoe]"], "value_options": ["Smart Books", "{jump_to}", "books"] },
      { "kind": "click", "selector_options": ["button[type=submit]:has-text('SIGN IN')", "button:has-text('SIGN IN')", "input[type=submit]"] },
      { "kind": "expect_visible", "selector_options": ["input[type=password]", "input[name=password]", "#password"], "timeout_ms": 30000, "on_failure_note": "Password step did not appear after selecting Jump To. Surface visible Jump To, credential, OTP, or challenge error text in failed_steps." },
      { "kind": "fill", "selector_options": ["input[type=password]", "input[name=password]", "#password"], "value": "{password}" },
      { "kind": "click", "selector_options": ["button[type=submit]:has-text('CONTINUE')", "button:has-text('CONTINUE')", "button:has-text('SIGN IN')", "input[type=submit]"] },
      { "kind": "expect_login_outcome", "success_url_matches": "/dashboard|/home|/companies|/company|/app|/books|/workspace", "login_url_matches": "/login", "error_selector_options": ["[role=alert]", ".alert-danger", ".error", ".invalid-feedback", "[class*=error]"], "error_text_matches": "jump to|credential|password|invalid|incorrect|otp|verification|challenge", "failed_steps_note": "Login remained on /login. Record visible Jump To, credential, password, OTP, verification, or challenge text." },
      { "kind": "expect_product_host", "expected_base_url": "{base_url}", "allowed_domains": "{allowed_domains}", "recover_once": true, "rule_code": "AUTH_PRODUCT_HOST_MATCH", "on_failure_note": "Login reached the wrong product host. Capture the landed URL and Jump To selection, then fail instead of collecting unrelated product evidence." },
      { "kind": "expect_visible", "selector": "[data-test=app-shell],main,#app,.app-shell,.dashboard,body" }
    ],
    "prod_full": [
