{
  "code": "BKS_001_LOGIN_CTX",
  "name": "Login & Company Context",
  "product": "books",
  "module": "Login",
  "description": "Login to Smart Books and confirm the authenticated app shell loads. On sandbox, also set company / branch / FY context.",
  "severity_on_fail": "critical",
  "steps": [
    { "kind": "navigate",     "to": "{login_url}",                                    "expect": "login form visible" },
    { "kind": "fill",         "selector": "input[name=email],input[name=username],input[type=email],input#email,input#username,#email,#username",  "value": "{username}" },
    { "kind": "fill",         "selector": "input[type=password],input[name=password],input#password,#password",                    "value": "{password}" },
    { "kind": "click",        "selector": "button[type=submit],input[type=submit],button:has-text('Login'),button:has-text('Sign in'),button:has-text('Log in')" },
    { "kind": "expect_url",   "matches": "/dashboard|/home|/companies|/company|/app|/books|/workspace" },
    { "kind": "select_or_create_company", "name_template": "{QA_RUN_ID} Test Company Pvt Ltd" },
    { "kind": "select_or_create_branch",  "name_template": "{QA_RUN_ID} HO" },
    { "kind": "select_or_create_financial_year", "name": "FY 2026-27", "start": "2026-04-01", "end": "2027-03-31" },
    { "kind": "expect_visible", "selector": "[data-test=app-shell],main,#app,.app-shell,.dashboard" }
  ],
  "steps_by_env": {
    "prod_basic": [
      { "kind": "navigate",     "to": "{login_url}",                                    "expect": "login form visible" },
      { "kind": "fill",         "selector": "input[name=email],input[name=username],input[type=email],input#email,input#username,#email,#username",  "value": "{username}" },
      { "kind": "fill",         "selector": "input[type=password],input[name=password],input#password,#password",                    "value": "{password}" },
      { "kind": "click",        "selector": "button[type=submit],input[type=submit],button:has-text('Login'),button:has-text('Sign in'),button:has-text('Log in')" },
      { "kind": "expect_url",   "matches": "/dashboard|/home|/companies|/company|/app|/books|/workspace" },
      { "kind": "expect_visible", "selector": "[data-test=app-shell],main,#app,.app-shell,.dashboard,body" }
    ],
    "prod_full": [
      { "kind": "navigate",     "to": "{login_url}",                                    "expect": "login form visible" },
      { "kind": "fill",         "selector": "input[name=email],input[name=username],input[type=email],input#email,input#username,#email,#username",  "value": "{username}" },
      { "kind": "fill",         "selector": "input[type=password],input[name=password],input#password,#password",                    "value": "{password}" },
      { "kind": "click",        "selector": "button[type=submit],input[type=submit],button:has-text('Login'),button:has-text('Sign in'),button:has-text('Log in')" },
      { "kind": "expect_url",   "matches": "/dashboard|/home|/companies|/company|/app|/books|/workspace" },
      { "kind": "expect_visible", "selector": "[data-test=app-shell],main,#app,.app-shell,.dashboard,body" }
    ]
  },
  "validations": ["UI_NO_BLANK_PAGE", "UI_NO_CRITICAL_CONSOLE"]
}
